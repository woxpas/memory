# Woxpas v0.1.0 — local install template
# Copy to .env and fill in. NEVER commit .env.
#
# Environment behaviour (local vs staging vs production) is controlled by
# individual settings, not a single toggle:
#   API_AUTH_MODE=dev               → loopback-only, header-based (local)
#   API_AUTH_MODE=jwt               → JWT validation (staging / production)
#   Reverse proxy → rate limiting   → see docs/GETTING_STARTED.md §16
#   docker-compose internal: true   → no exposed ports (production)
#   WOXPAS_DEV_DEK_HEX              → omit in production (use boot daemon)

# ─── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_DB=woxpas
POSTGRES_USER=woxpas
POSTGRES_PASSWORD=                    # generated at install
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ─── Qdrant ────────────────────────────────────────────────────────────────
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=                       # generated at install

# ─── Object store (MinIO / S3-compatible) ──────────────────────────────────
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ROOT_USER=woxpas
MINIO_ROOT_PASSWORD=                  # generated at install
MINIO_BUCKET_RAW=woxpas-raw
MINIO_BUCKET_CANONICAL=woxpas-canonical
MINIO_BUCKET_SUMMARIES=woxpas-summaries
MINIO_USE_TLS=false

# ─── ClamAV ────────────────────────────────────────────────────────────────
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ─── API gateway (localhost-only by default) ───────────────────────────────
API_HOST=127.0.0.1
API_PORT=7800

# Auth mode:
#   dev                  — strict; requires X-Woxpas-Tenant-Id header on every request
#   single_tenant_local  — loopback-only; auto-uses WOXPAS_DEV_TENANT_ID_DEFAULT if header missing
#   jwt                  — production; validates Bearer JWT (Supabase-shaped)
API_AUTH_MODE=dev

# ─── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Pipeline / model selection ────────────────────────────────────────────
# Models are looked up by logical name in the runtime catalog
# (woxpas_runtime.MODEL_CATALOG). Leave blank to use built-in defaults.
# Future settings UI writes to these same vars.
PIPELINE_VERSION=0.1.0
SUMMARY_MODEL_NAME=             # default: qwen2.5-1.5b-instruct-q4km
EXTRACTION_MODEL_NAME=          # defaults to summary model if unset
EMBED_MODEL_NAME=               # default: bge-m3-onnx
RERANKER_MODEL_NAME=            # default: bge-reranker-v2-m3-onnx (int8)

# ─── Cloud LLM API keys (only needed if SUMMARY_MODEL_NAME or
# EXTRACTION_MODEL_NAME points at a cloud entry). Keep blank for offline-only.
# Naming convention: WOXPAS_KEY_<PROVIDER>. The catalog entries reference
# these env var names via ModelArtefact.api_key_env. Audit log records every
# cloud egress; gate blocks personal-data profiles unless tenants
# .allow_cloud_for_personal_data is on (flip via woxpas-cli set-cloud-policy).
WOXPAS_KEY_DEEPSEEK=
WOXPAS_KEY_ANTHROPIC=
WOXPAS_KEY_OPENAI=
WOXPAS_KEY_KIMI=

# ─── Hardware probe (auto-detected at boot, override if needed) ────────────
ACCEL_BACKEND=auto                    # auto | cuda | metal | rocm | cpu

# ─── Crypto ────────────────────────────────────────────────────────────────
# Argon2id parameters for passphrase → KEK derivation. These are the defaults
# (~500ms on a modern laptop). The params are persisted per-tenant at init time;
# changing these here only affects new tenants created after the change.
